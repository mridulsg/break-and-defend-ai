# Copy to .env (shared/scripts/setup.sh does this for you). Never commit .env.

# Your OpenRouter API key. Create a key just for these labs and set a credit limit on it.
# Only the gateway container reads this. Lab containers never see it.
OPENROUTER_API_KEY=

# Local-only key that lab containers use to talk to the gateway.
# setup.sh generates it. It is not a provider key.
BDAI_GATEWAY_KEY=

# Hard spend cap in US dollars across all labs. The gateway refuses calls beyond it.
BDAI_MAX_BUDGET_USD=5

# Upper bound on output tokens per request (the gateway clamps larger values).
BDAI_MAX_TOKENS=4096
