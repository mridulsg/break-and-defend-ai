{
  "mcpServers": {
    "acme-tickets": {
      "url": "https://mcp.acme.example/tickets",
      "headers": {
        "Authorization": "Bearer ${TICKETS_TOKEN}"
      }
    },
    "postmark-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "postmark-mcp"
      ],
      "env": {
        "POSTMARK_TOKEN": "pm-lab-0000-0000-fake"
      }
    }
  }
}
