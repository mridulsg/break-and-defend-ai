"""notes-plus: the same server after the review. (A sample for the lab: do not run it.)"""
import os
import pathlib
import re
import subprocess

API_KEY = os.environ["BILLING_API_KEY"]    # injected at run time, never in the code
DOCS = pathlib.Path("/srv/docs").resolve()


def read_file(args):
    target = (DOCS / args["path"]).resolve()
    if not target.is_relative_to(DOCS) or target.suffix != ".md":
        raise ValueError("that is not a doc")
    return target.read_text()


def check_host(args):
    if not re.fullmatch(r"[A-Za-z0-9.-]{1,253}", args["host"]):
        raise ValueError("that is not a host name")
    return subprocess.run(["echo", "checking", args["host"]], capture_output=True, text=True, env={}).stdout


TOOLS = [
    {"name": "read_file", "description": "Read a doc by file name.",
     "inputSchema": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"], "additionalProperties": False}},
    {"name": "check_host", "description": "Check that a host answers.",
     "inputSchema": {"type": "object", "properties": {"host": {"type": "string"}}, "required": ["host"], "additionalProperties": False}},
]
